+int ksu_handle_toolkit_reboot(int magic2, unsigned int cmd, void __user *arg)
+{
+    unsigned long reply = (unsigned long)arg;
+
+    if (magic2 == CHANGE_MANAGER_UID) {
+        /* only root is allowed for this command */
+        if (current_uid().val != 0)
+            return -EPERM;
+        pr_info("ksu_handle_toolkit_reboot: ksu_set_manager_appid to: %d\n", cmd);
+        ksu_set_manager_appid(cmd);
+        if (cmd == ksu_get_manager_appid()) {
+            if (copy_to_user(arg, &reply, sizeof(reply))) {
+                pr_info("ksu_handle_toolkit_reboot: reply fail\n");
+                return -EFAULT;
+            }
+        }
+        return 0;
+    }
+
+    if (magic2 == GET_SULOG_DUMP_V2) {
+        /* only root is allowed for this command */
+        if (current_uid().val != 0)
+            return -EPERM;
+
+        int ret = ksu_sulog_handle_compat_dump(arg);
+        if (ret)
+            return ret;
+
+        if (copy_to_user(arg, &reply, sizeof(reply))) {
+            pr_info("ksu_handle_toolkit_reboot: reply fail\n");
+            return -EFAULT;
+        }
+        return 0;
+    }
+
+    if (magic2 == CHANGE_KSUVER) {
+        /* only root is allowed for this command */
+        if (current_uid().val != 0)
+            return -EPERM;
+        pr_info("ksu_handle_toolkit_reboot: ksu_change_ksuver to: %d\n", cmd);
+        ksuver_override = cmd;
+        if (copy_to_user(arg, &reply, sizeof(reply))) {
+            pr_info("ksu_handle_toolkit_reboot: reply fail\n");
+            return -EFAULT;
+        }
+        return 0;
+    }
+
+    if (magic2 == CHANGE_SPOOF_UNAME) {
+        // SUSFS owns uname spoofing via CMD_SUSFS_SET_UNAME.
+        // Acknowledge the legacy toolkit command so managers do not hang.
+        reply = 0;
+        if (copy_to_user(arg, &reply, sizeof(reply))) {
+            pr_info("ksu_handle_toolkit_reboot: reply fail\n");
+            return -EFAULT;
+        }
+        return 0;
+    }
+
+    return -EINVAL;
+}
